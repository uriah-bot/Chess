<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Base Layers  -->
    <Color x:Key="Color.Background">#111111</Color>
    <Color x:Key="Color.Surface">#1B1B1B</Color>
    <Color x:Key="Color.SurfaceElevated">#222222</Color>

    <!--  Accent  -->
    <Color x:Key="Color.Accent">#7C5CFF</Color>
    <Color x:Key="Color.AccentHover">#9276FF</Color>
    <Color x:Key="Color.AccentPressed">#6846E0</Color>

    <!--  Text  -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#AAAAAA</Color>
    <Color x:Key="Color.SettingsInfoText">Gray</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.SettingsInfoText" Color="{StaticResource Color.SettingsInfoText}" />

</ResourceDictionary>