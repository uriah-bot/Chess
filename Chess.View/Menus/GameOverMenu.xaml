<UserControl
    x:Class="Chess.View.GameOverMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Width="275"
        Height="125"
        RenderOptions.BitmapScalingMode="HighQuality"
        Style="{StaticResource ResourceKey=MenuBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="WinnerTextBlock"
                Grid.ColumnSpan="2"
                FontSize="28"
                Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                Text="WINNER" />
            <TextBlock
                x:Name="ReasonTextBlock"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                FontSize="16"
                Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                Text="REASON FOR WIN" />
            <Button
                Name="RestartButton"
                Grid.Row="2"
                Width="80"
                Height="30"
                Click="Restart_Click"
                Content="RESTART"
                Style="{StaticResource ResourceKey=MenuButtonStyle}" />

            <Button
                Name="ExitButton"
                Grid.Row="2"
                Grid.Column="1"
                Width="80"
                Height="30"
                Click="Exit_Click"
                Content="EXIT"
                Style="{StaticResource ResourceKey=MenuButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
