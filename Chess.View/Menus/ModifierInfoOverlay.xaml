<UserControl
    x:Class="Chess.View.Menus.ModifierInfoOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View.Menus"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid Grid.RowSpan="3">
        <Border
            Width="400"
            Padding="25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1E1E1E"
            BorderBrush="#333"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="30"
                    Opacity="0.8"
                    ShadowDepth="5"
                    Color="Black" />
            </Border.Effect>

            <StackPanel>
                <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                    <Border
                        Width="50"
                        Height="50"
                        Background="#2A2A2A"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{Binding ModifierIconFontFamily, Converter={StaticResource StringToFontFamily}}"
                            FontSize="28"
                            Foreground="{Binding IconFontColor, Converter={StaticResource StringToBrush}}"
                            Text="{Binding ModifierIcon}" />
                    </Border>
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding ModifierName}" />
                </StackPanel>

                <Border
                    Margin="0,0,0,20"
                    Padding="15"
                    Background="#151515"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#888"
                            Text="TYPE:" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding ModifierType}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#888"
                            Text="DURATION:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding ModifierDuration}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#888"
                            Text="CUSTOMIZE:"
                            Visibility="{Binding IsDynamicModifier, Converter={StaticResource BoolToVis}}" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            MaxHeight="35"
                            ItemsSource="{Binding DynamicModifierItemSource}"
                            SelectedItem="{Binding SelectedDynamicItem, Mode=TwoWay}"
                            Style="{StaticResource ModernComboBox}"
                            Visibility="{Binding IsDynamicModifier, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#888"
                    Text="MECHANICS" />
                <TextBlock
                    Margin="0,0,0,25"
                    FontSize="14"
                    Foreground="#DDDDDD"
                    LineHeight="22"
                    Text="{Binding ModifierDescription}"
                    TextWrapping="Wrap" />
                <Button
                    Height="40"
                    BorderThickness="0"
                    Command="{Binding CloseViewModelCommand}"
                    Content="CLOSE"
                    Style="{StaticResource DefaultButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
