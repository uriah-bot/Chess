<UserControl
    x:Class="Chess.View.GamePausedMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Width="275"
        Height="125"
        RenderOptions.BitmapScalingMode="HighQuality"
        Style="{StaticResource ResourceKey=MenuBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.8*" />
                <RowDefinition Height="0.7*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                FontSize="28"
                Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                Text="GAME PAUSED" />
            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="2"
                FontSize="10"
                Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                Text="NOTE: RESIGNING WILL EFFECT STATS"
                TextAlignment="Center" />
            <Button
                Name="ResignButton"
                Grid.Row="1"
                Width="80"
                Height="30"
                Click="Resign_Click"
                Content="RESIGN"
                Style="{StaticResource ResourceKey=MenuButtonStyle}" />

            <Button
                Name="ContinueButton"
                Grid.Row="1"
                Grid.Column="1"
                Width="80"
                Height="30"
                Click="Continue_Click"
                Content="CONTINUE"
                Style="{StaticResource ResourceKey=MenuButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
