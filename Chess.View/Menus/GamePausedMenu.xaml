<UserControl
    x:Class="Chess.View.Menus.GamePausedMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View.Menus"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">
    <Border
        Width="275"
        Height="125"
        RenderOptions.BitmapScalingMode="HighQuality"
        Style="{StaticResource ResourceKey=MenuBorderStyle}">

        <Grid>
            <Grid>
                <Grid.Style>
                    <Style BasedOn="{StaticResource DynamicGridStyle}" TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameMode}" Value="Standard">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.8*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="0.5*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                    Text="GAME PAUSED" />
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    FontSize="10"
                    Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                    Text="NOTE: RESIGNING WILL AFFECT STATS"
                    TextAlignment="Center" />

                <Button
                    Grid.Row="1"
                    Width="80"
                    Height="30"
                    Command="{Binding ResignCommand}"
                    Content="RESIGN"
                    Style="{StaticResource ResourceKey=MenuButtonStyle}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="80"
                    Height="30"
                    Command="{Binding ContinueCommand}"
                    Content="CONTINUE"
                    Style="{StaticResource ResourceKey=MenuButtonStyle}" />
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style BasedOn="{StaticResource DynamicGridStyle}" TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameMode}" Value="Modified">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.8*" />
                    <RowDefinition Height="0.7*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Style="{StaticResource ResourceKey=MenuTextBlockStyle}"
                    Text="GAME PAUSED" />
                <Button
                    Grid.Row="1"
                    Width="80"
                    Height="30"
                    Command="{Binding RestartCommand}"
                    Content="RESTART"
                    Style="{StaticResource ResourceKey=MenuButtonStyle}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="80"
                    Height="30"
                    Command="{Binding ContinueCommand}"
                    Content="CONTINUE"
                    Style="{StaticResource ResourceKey=MenuButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
