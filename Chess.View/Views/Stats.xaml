<UserControl
    x:Class="Chess.View.Stats"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentColor" Color="#4CD964" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,0,0,30">
            <TextBlock
                Margin="20,0,20,0"
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"
                Text="Statistics" />
            <TextBlock
                Margin="20,0,20,0"
                FontSize="14"
                Foreground="#888"
                Text="Analyze your performance across all modes." />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="20,0,20,0"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Games Played" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="1,245" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#4CD964"
                                Text="+12 this week" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Win Rate" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentColor}"
                                Text="54.2%" />
                            <ProgressBar
                                Height="4"
                                Margin="0,10,0,0"
                                Background="#333"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentColor}"
                                Value="54" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Current ELO" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="1450" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Peak: 1495" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Classical Match History" />

                <ItemsControl>
                    <Border
                        Margin="0,0,0,10"
                        Padding="15"
                        Background="#202020"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                Background="#204CD964"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#4CD964"
                                    Text="W" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="vs. Stockfish (Level 5)" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="Classical • 15 min • 32 Moves" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold"
                                    Foreground="#4CD964"
                                    Text="+12 ELO" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="Yesterday" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,0,0,10"
                        Padding="15"
                        Background="#202020"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Left"
                                Background="#20FF5555"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#FF5555"
                                    Text="L" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="vs. The Dark Knight" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="Adventure • Level 3 • 45 Moves" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold"
                                    Foreground="#FF5555"
                                    Text="-8 ELO" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="2 Days ago" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ItemsControl>

                <Rectangle Height="40" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
