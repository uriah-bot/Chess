<UserControl
    x:Class="Chess.View.Stats"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentColor" Color="#4CD964" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,0,0,30">
            <TextBlock
                Margin="20,0,20,0"
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"
                Text="Statistics" />
            <TextBlock
                Margin="20,0,20,0"
                FontSize="14"
                Foreground="#888"
                Text="Analyze your performance across all modes." />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="20,0,20,0"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Games Played" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding TotalMatches}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Win Rate" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentColor}"
                                Text="{Binding WinRate}" />
                            <ProgressBar
                                Height="4"
                                Margin="0,10,0,0"
                                Background="#333"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentColor}"
                                Value="{Binding WinRateBar, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="20"
                        Background="#252526"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="#888"
                                Text="Current ELO" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Elo}" />
                            <DockPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#888"
                                    Text="Peak: " />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#888"
                                    Text="{Binding PeakElo}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Classical Match History" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding GameHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,10"
                                Padding="15"
                                Background="#202020"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="#20FF5555"
                                        CornerRadius="20">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="{Binding Result}"
                                            Text="{Binding Result}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding AIName, FallbackValue=''}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="Gray"
                                            Text="{Binding GameMode}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="Bold"
                                            Foreground="{Binding Result}"
                                            Text="{Binding EloDelta}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="Gray"
                                            Text="{Binding Time}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Height="40" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
