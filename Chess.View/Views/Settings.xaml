<UserControl
    x:Class="Chess.View.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5,10,0,10" />
            <Setter Property="Background" Value="#333" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C5CE7" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="5,20,0,10" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton
                                Padding="0,5"
                                Cursor="Hand"
                                DockPanel.Dock="Top"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Background="Transparent" Orientation="Horizontal">

                                            <Border
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource Brush.Accent}"
                                                CornerRadius="10">
                                                <Path
                                                    x:Name="Arrow"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 1,1.5 L 4.5,5 8,1.5"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Stroke="White"
                                                    StrokeThickness="2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>

                                            <ContentPresenter
                                                VerticalAlignment="Center"
                                                Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                TextElement.FontSize="16"
                                                TextElement.Foreground="White" />
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                                x:Name="ExpandSite"
                                Margin="0,10,0,0"
                                DockPanel.Dock="Bottom"
                                Visibility="Collapsed" />
                        </DockPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />

                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle
                                                    x:Name="ThumbRectangle"
                                                    Width="10"
                                                    Height="16"
                                                    Cursor="Hand"
                                                    Fill="{StaticResource Brush.Accent}" />

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Cursor" Value="SizeWE" />
                                                        <Setter TargetName="ThumbRectangle" Property="Fill" Value="{StaticResource Brush.AccentHover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- <Grid.LayoutTransform>
    <ScaleTransform ScaleX="1.9" ScaleY="1.9"></ScaleTransform>
</Grid.LayoutTransform>  reason: doesnt fit when applied in the AppBase-->

        <StackPanel Grid.Row="0" Margin="5,0,0,30">
            <TextBlock
                Margin="10,0,10,0"
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"
                Text="Settings" />
            <TextBlock
                Margin="10,0,10,0"
                FontSize="14"
                Foreground="#888"
                Text="You have full control! Experience every feature to its fullest." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="5,0,20,0">
                <TextBlock
                    Margin="5,0,0,10"
                    Style="{StaticResource SectionHeader}"
                    Text="General" />

                <Border
                    Padding="15"
                    Background="#252526"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeader}" Text="Audio" />
                        <DockPanel Margin="0,5,0,15" LastChildFill="True">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="Radio Volume" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Foreground="Gray"
                                Text="80%" />
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                TickFrequency="5"
                                Value="80" />
                        </DockPanel>

                        <CheckBox Content="Mute Radio during matches" />
                        <CheckBox Content="Play sound effects on move" />

                        <Border
                            Margin="10"
                            Padding="10"
                            Background="#2D2D30"
                            CornerRadius="8">

                            <Expander
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Header="Radio Channels"
                                IsExpanded="False">

                                <Grid Margin="0,15,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ScrollViewer
                                        Grid.Row="0"
                                        MaxHeight="150"
                                        Margin="0,0,0,10"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="MusicListPanel">
                                            <RadioButton
                                                Margin="0,5"
                                                Content="Classical (Mozart)"
                                                Foreground="LightGray"
                                                GroupName="MusicOptions" />
                                            <RadioButton
                                                Margin="0,5"
                                                Content="Lofi Beats"
                                                Foreground="LightGray"
                                                GroupName="MusicOptions" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button
                                        Grid.Row="1"
                                        Height="35"
                                        Padding="10,5"
                                        BorderThickness="0"
                                        Content="+ Add Music as .mp3"
                                        Cursor="Hand"
                                        Foreground="White"
                                        Style="{StaticResource DefaultButton}" />
                                </Grid>

                            </Expander>
                        </Border>

                        <Separator Margin="0,15,0,15" Background="#333" />

                        <TextBlock Style="{StaticResource SettingHeader}" Text="Visuals" />
                        <CheckBox Content="Show legal moves highlights" />
                        <CheckBox Content="Display coordinates (A-H, 1-8)" IsChecked="True" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Classical Mode" />
                <Border
                    Padding="15"
                    Background="#252526"
                    CornerRadius="8">

                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeader}" Text="In-Game" />
                        <CheckBox Content="Auto play as white" />
                        <CheckBox Content="Show engine evaluation bar" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SectionHeader}" Text="User Settings" />
                <Border
                    Padding="15"
                    Background="#252526"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingHeader}" Text="Personal Info" />

                        <DockPanel Margin="0,5,0,5" LastChildFill="True">
                            <TextBlock
                                Width="70"
                                Foreground="White"
                                Text="Username:" />
                            <Border
                                Width="230"
                                Height="15"
                                Background="{StaticResource Brush.SurfaceElevated}"
                                CornerRadius="4">
                                <TextBox
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    IsEnabled="False"
                                    Text="{Binding Username}" />
                            </Border>
                            <Button
                                Width="20"
                                Height="20"
                                Content="&#x270E;"
                                Style="{StaticResource DefaultButton}" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,5" LastChildFill="True">
                            <TextBlock
                                Width="70"
                                Foreground="White"
                                Text="Passowrd:" />
                            <Border
                                Width="230"
                                Height="15"
                                Background="{StaticResource Brush.SurfaceElevated}"
                                CornerRadius="4">
                                <TextBox
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    IsEnabled="False"
                                    Text="-Hidden-  To View/Change Password -&gt;" />
                            </Border>
                            <Button
                                Width="20"
                                Height="20"
                                Content="&#x270E;"
                                Style="{StaticResource DefaultButton}" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,5" LastChildFill="True">
                            <TextBlock
                                Width="70"
                                Foreground="White"
                                Text="User Role:" />
                            <Border
                                Width="230"
                                Height="15"
                                Background="{StaticResource Brush.SurfaceElevated}"
                                CornerRadius="4">
                                <TextBox
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    IsEnabled="False"
                                    Text="{Binding Role, Mode=OneWay}" />
                            </Border>
                            <Button
                                Width="20"
                                Height="20"
                                Content="&#xE8D7;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource DefaultButton}"
                                ToolTip="Request Role" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Expander Margin="2,20,0,0">
                    <Expander.Header>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#AAAAAA"
                            Text="Sensitive Settings" />
                    </Expander.Header>
                    <Border
                        Margin="10,10,10,0"
                        Background="#252526"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Margin="10,10,0,10"
                                FontWeight="Bold"
                                Foreground="#FF5555"
                                Text="Danger Zone" />
                            <!--  TODO: this button appears white when disabled  -->
                            <Button
                                Width="200"
                                Height="35"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                Background="#990000"
                                BorderThickness="0"
                                Command="{Binding DeleteUserCommand}"
                                Content="DELETE USER"
                                FontWeight="Bold"
                                Foreground="White"
                                Visibility="{Binding CanDeleteUser, Converter={StaticResource BoolToVis}}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Expander>

                <Rectangle Height="50" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
