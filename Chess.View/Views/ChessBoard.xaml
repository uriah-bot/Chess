<UserControl
    x:Class="Chess.View.ChessBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:external="clr-namespace:Chess.ViewModel;assembly=Chess.ViewModel"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#000000"
    Cursor="{Binding CurrentPlayer, Converter={StaticResource PlayerColorToCursor}}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="1"
            Width="600"
            Height="600">
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Default/Board.png" />
            </Grid.Background>

            <ItemsControl ItemsSource="{Binding Squares}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="{Binding HighlightBrush, Converter={StaticResource StringToBrush}}">

                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Piece, Converter={StaticResource PieceToImage}}" />

                            <TextBlock
                                Margin="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="1"
                                FontSize="14"
                                Text="{Binding Coordinate}" />

                            <Rectangle Fill="{Binding OverlayBrush, Converter={StaticResource StringToBrush}}" IsHitTestVisible="False" />

                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding SquareLeftClickedCommand}" Gesture="LeftClick" />
                                <MouseBinding Command="{Binding SquareRightClickedCommand}" Gesture="RightClick" />
                            </Grid.InputBindings>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Canvas x:Name="DrawingCanvas" IsHitTestVisible="False" />
        </Grid>

        <Border Grid.Row="0" Visibility="{Binding IsClassicalGame, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Height="54" LastChildFill="True">
                    <Button
                        MinWidth="200"
                        MinHeight="35"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding PauseGameCommand}"
                        Content="&#xE769;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Style="{StaticResource DefaultButton}" />

                    <TextBlock
                        Margin="30,3,10,0"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Foreground="White"
                        Text="{Binding Username}" />
                    <TextBlock
                        Margin="5,3,0,0"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Foreground="White"
                        Text="{Binding AIName}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Visibility="{Binding IsReplayMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Height="54" LastChildFill="True">
                    <Button
                        Width="150"
                        MinHeight="35"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ReplayBackwardsCommand}"
                        Content="◀ "
                        FontSize="16"
                        Style="{StaticResource DefaultButton}" />
                    <Button
                        Width="150"
                        MinHeight="35"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding StopReplayCommand}"
                        Content="Exit"
                        FontSize="16"
                        Style="{StaticResource DefaultButton}" />
                    <Button
                        Width="150"
                        MinHeight="35"
                        Margin="10,0,0,0"
                        Command="{Binding ReplayForwardsCommand}"
                        Content="▶"
                        FontSize="16"
                        Style="{StaticResource DefaultButton}" />
                    <TextBlock
                        Margin="30,3,10,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="White"
                        Text="{Binding Username}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="200"
            Padding="20"
            Background="#181818"
            Visibility="{Binding IsModifiedGame, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border
                    Margin="0,0,0,10"
                    Padding="0,15,0,15"
                    VerticalAlignment="Top"
                    Background="#222222"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#888"
                            Text="GUEST" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding BlackUserTimerText}" />
                    </StackPanel>
                </Border>

                <Button
                    Margin="0,0,0,15"
                    VerticalAlignment="Center"
                    Command="{Binding PauseGameCommand}"
                    Content="&#xE769;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Style="{StaticResource DefaultButton}" />

                <Border
                    Padding="0,15,0,15"
                    VerticalAlignment="Bottom"
                    Background="#222222"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding WhiteUserTimerText}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#888"
                            Text="{Binding Username}" />
                    </StackPanel>
                </Border>
                <StackPanel />
            </Grid>
        </Border>
    </Grid>
</UserControl>
