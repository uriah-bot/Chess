<UserControl
    x:Class="Chess.View.Classical"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SelectionCard" TargetType="RadioButton">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border
                                x:Name="BaseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                            <Border
                                x:Name="HighlightOverlay"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="6" />
                            <ContentPresenter
                                Margin="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BaseBorder" Property="Background" Value="#303030" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="BaseBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />

                                <Setter TargetName="HighlightOverlay" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.2" Color="{StaticResource Color.Accent}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="New Classical Game" />
                <TextBlock
                    FontSize="14"
                    Foreground="#888"
                    Text="Challenge the engine at your preferred difficulty." />
            </StackPanel>

            <Button
                Padding="0"
                HorizontalAlignment="Right"
                BorderThickness="0"
                Command="{Binding NavigateToSettingsCommand}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock
                                x:Name="IconText"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                Text="&#xE713;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource Brush.AccentHover}" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <Border
                Margin="0,0,0,20"
                Padding="15"
                Background="#252526"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="5,0,0,10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="I want to play as:" />
                    <UniformGrid Margin="0,0,0,30" Columns="3">
                        <RadioButton
                            Command="{Binding SelectColorCommand}"
                            CommandParameter="White"
                            GroupName="ColorGroup"
                            Style="{StaticResource SelectionCard}">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Foreground="White"
                                    Text="♙" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="White" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            Command="{Binding SelectColorCommand}"
                            CommandParameter="Random"
                            GroupName="ColorGroup"
                            IsChecked="True"
                            Style="{StaticResource SelectionCard}">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Emoji"
                                    FontSize="36"
                                    Text="🌗" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Random" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            Command="{Binding SelectColorCommand}"
                            CommandParameter="Black"
                            GroupName="ColorGroup"
                            Style="{StaticResource SelectionCard}">
                            <StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Foreground="#888"
                                    Text="♟" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Black" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock
                        Margin="5,0,0,10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Stockfish Difficulty:" />
                    <UniformGrid Margin="0,0,0,30" Columns="2">
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="800"
                            GroupName="EloGroup"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Beginner (800)" />
                        </RadioButton>
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="1200"
                            GroupName="EloGroup"
                            IsChecked="True"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Amateur (1200)" />
                        </RadioButton>
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="1600"
                            GroupName="EloGroup"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Intermediate (1600)" />
                        </RadioButton>
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="2000"
                            GroupName="EloGroup"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Advanced (2000)" />
                        </RadioButton>
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="2500"
                            GroupName="EloGroup"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="Master (2500)" />
                        </RadioButton>
                        <RadioButton
                            Command="{Binding BotEloSelectedCommand}"
                            CommandParameter="3200"
                            GroupName="EloGroup"
                            Style="{StaticResource SelectionCard}">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#FF5555"
                                Text="Grandmaster (3200)" />
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Button
            Grid.Row="2"
            Height="50"
            Command="{Binding StartClassicalGameCommand}"
            FontSize="18"
            FontWeight="Bold"
            Style="{StaticResource DefaultButton}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="▶" />
                <TextBlock VerticalAlignment="Center" Text="Play vs Stockfish" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
