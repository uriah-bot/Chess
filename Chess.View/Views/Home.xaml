<UserControl
    x:Class="Chess.View.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="500"
    Background="Transparent"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="25" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.4"
                        ShadowDepth="5"
                        Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock
                FontSize="16"
                Foreground="#AAAAAA"
                Text="{Binding WelcomeText}" />
            <TextBlock
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"
                Text="Ready to play?" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource DashboardCard}">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Classical Mode" />
                    <TextBlock
                        Margin="0,5,0,25"
                        FontSize="16"
                        Foreground="#AAAAAA"
                        Text="Rated match versus Engine" />

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Width="140"
                            Height="45"
                            Command="{Binding NavigateToClassicalCommand}"
                            Content="Start Match"
                            FontSize="16"
                            Style="{StaticResource DefaultButton}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="30"
                            Foreground="{StaticResource Brush.Accent}"
                            Text="&#xEA18;" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="#2D2D30"
                Style="{StaticResource DashboardCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="40"
                        Foreground="{StaticResource Brush.Accent}"
                        Text="&#xE819;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Adventure Mode" />
                    <TextBlock
                        Margin="0,5,0,20"
                        FontSize="12"
                        Foreground="Gray"
                        Text="Discover new ways to play Chess"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Height="35"
                        Padding="15,0"
                        Command="{Binding NavigateToAdventureCommand}"
                        Content="Modifier Selection"
                        FontFamily="Segoe UI"
                        Style="{StaticResource DefaultButton}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="50"
                        Height="50"
                        Margin="0,0,20,0"
                        Background="#2A2A35"
                        CornerRadius="25">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="Gold"
                            Text="&#x1F3C6;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Global Leaderboard" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="13"
                            Foreground="#888"
                            Text="See where you rank against the best players in the world." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel
                            Height="40"
                            Margin="10,0,5,0"
                            VerticalAlignment="Center"
                            Opacity="0.6"
                            Orientation="Horizontal">
                            <Rectangle
                                Width="8"
                                Height="20"
                                Margin="2"
                                VerticalAlignment="Bottom"
                                Fill="#333" />
                            <Rectangle
                                Width="8"
                                Height="35"
                                Margin="2"
                                VerticalAlignment="Bottom"
                                Fill="{StaticResource Brush.Accent}" />
                            <Rectangle
                                Width="8"
                                Height="15"
                                Margin="2"
                                VerticalAlignment="Bottom"
                                Fill="#333" />
                            <Rectangle
                                Width="8"
                                Height="40"
                                Margin="2"
                                VerticalAlignment="Bottom"
                                Fill="{StaticResource Brush.Accent}" />
                        </StackPanel>
                        <Button
                            Width="130"
                            Height="40"
                            Command="{Binding NavigateToLeaderboardCommand}"
                            Content="View Rankings"
                            Style="{StaticResource DefaultButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
