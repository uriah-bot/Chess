<UserControl
    x:Class="Chess.View.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.4"
                        ShadowDepth="5"
                        Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock
                FontSize="16"
                Foreground="#AAAAAA"
                Text="{Binding WelcomeText}" />
            <TextBlock
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"
                Text="Ready to play?" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource DashboardCard}">
                <Grid>
                    <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Classical Mode" />
                        <TextBlock
                            Margin="0,5,0,15"
                            Foreground="{StaticResource Brush.TextSecondary}"
                            Text="Rated match versus Engine" />

                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="120"
                                Height="40"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateToClassicalCommand}"
                                Content="Start Match"
                                Style="{StaticResource DefaultButton}" />
                            <TextBlock
                                Margin="10,5,0,0"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="30"
                                Foreground="{StaticResource Brush.Accent}"
                                Text="&#xEA18;" />
                            <Image
                                Width="40"
                                Height="40"
                                Margin="10,0,0,0"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/Stockfish_icon.png"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Background="#2D2D30"
                Style="{StaticResource DashboardCard}">
                <StackPanel
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="-2,0,0,5"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="30"
                        Foreground="{StaticResource Brush.Accent}"
                        Text="&#xE819;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Adventure Mode" />
                    <TextBlock
                        Margin="0,5,0,10"
                        FontSize="11"
                        Foreground="Gray"
                        Text="Discover new ways to play Chess"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Height="20"
                        Command="{Binding NavigateToAdventureCommand}"
                        Content="Modifier Selection"
                        FontFamily="Segoe UI"
                        Style="{StaticResource DefaultButton}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,20,0"
                Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#6C5CE7"
                            Text="" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Height="50"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <Rectangle
                            Width="10"
                            Height="30"
                            Margin="2"
                            Fill="#333" />
                        <Rectangle
                            Width="10"
                            Height="45"
                            Margin="2"
                            Fill="#6C5CE7" />
                        <Rectangle
                            Width="10"
                            Height="20"
                            Margin="2"
                            Fill="#333" />
                        <Rectangle
                            Width="10"
                            Height="40"
                            Margin="2"
                            Fill="#6C5CE7" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
