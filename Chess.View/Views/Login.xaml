<UserControl
    x:Class="Chess.View.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource Brush.Background}"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid>
        <Border
            MinWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}">
            <StackPanel Margin="0,-20,0,0">
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    Text="♟" />
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="Welcome Back" />
                <TextBlock
                    Margin="0,5,0,25"
                    Style="{StaticResource SubtitleTextStyle}"
                    Text="Enter your details to log in" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="USERNAME" />
                <TextBox
                    x:Name="UsernameTextBox"
                    FontSize="18"
                    Style="{StaticResource InfoInputTextBoxStyle}"
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=UsernameTextBox}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="#FF5555"
                                    Text="&#xE783;" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FF5555"
                                    Text="{Binding ErrorContent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,20,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="PASSWORD" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Margin="0,0,0,5"
                    local:PasswordService.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    FontSize="18"
                    Style="{StaticResource PasswordBoxStyle}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=PasswordBox}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="#FF5555"
                                    Text="&#xE783;" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FF5555"
                                    Text="{Binding ErrorContent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox
                    x:Name="PasswordVisibilityCheckBox"
                    Margin="0,0,0,5"
                    Content="Show Password"
                    Foreground="White" />
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Right"
                    Style="{StaticResource LinkTextStyle}"
                    Text="Forgot Password?" />
                <StackPanel>
                    <Button
                        x:Name="LoginButton"
                        Command="{Binding LoginCommand}"
                        Content="LOGIN"
                        Style="{StaticResource DefaultButton}"
                        Validation.ErrorTemplate="{x:Null}" />
                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=LoginButton}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="#FF5555"
                                        Text="&#xE783;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#FF5555"
                                        Text="{Binding ErrorContent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Don't have an account? " />
                    <Button
                        Padding="0"
                        BorderThickness="0"
                        Command="{Binding NavigateToRegisterCommand}"
                        Content="Sign Up"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock Style="{StaticResource LinkTextStyle}" Text="Register" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
