<UserControl
    x:Class="Chess.View.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource Brush.Background}"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid Width="420" Height="515">
        <Border
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}">

            <StackPanel Margin="0,-20,0,0">

                <!--  Icon  -->
                <TextBlock
                    Margin="0,0,0,15"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    Text="♟" />

                <!--  Title  -->
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="Welcome Back" />

                <TextBlock
                    Margin="0,5,0,25"
                    Style="{StaticResource SubtitleTextStyle}"
                    Text="Enter your details to log in" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="USERNAME" />
                <TextBox
                    Margin="0,0,0,20"
                    FontSize="18"
                    Style="{StaticResource InfoInputTextBoxStyle}"
                    Text="{Binding Username, Mode=OneWayToSource}" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="PASSWORD" />
                <PasswordBox
                    Margin="0,0,0,5"
                    FontSize="18"
                    Style="{StaticResource PasswordBoxStyle}" />
                <CheckBox
                    x:Name="PasswordVisibilityCheckBox"
                    Margin="0,0,0,5"
                    Content="Show Password"
                    Foreground="White" />
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Right"
                    Style="{StaticResource LinkTextStyle}"
                    Text="Forgot Password?" />
                <Button
                    Command="{Binding LoginCommand}"
                    Content="LOGIN"
                    Style="{StaticResource DefaultButton}" />
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Don't have an account? " />
                    <Button
                        Padding="0"
                        BorderThickness="0"
                        Command="{Binding NavigateToRegisterCommand}"
                        Content="Sign Up"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock Style="{StaticResource LinkTextStyle}" Text="Register" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
