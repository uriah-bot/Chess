<UserControl
    x:Class="Chess.View.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource Brush.Background}"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid>
        <Border
            MinWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}">
            <StackPanel Margin="0,-20,0,0">
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    Text="♟" />
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="Create Account" />
                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource SubtitleTextStyle}"
                    Text="Start your chess journey" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="USERNAME" />
                <TextBox
                    x:Name="UsernameTextBox"
                    FontSize="18"
                    Style="{StaticResource InfoInputTextBoxStyle}"
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=UsernameTextBox}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="#FF5555"
                                    Text="&#xE783;" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FF5555"
                                    Text="{Binding ErrorContent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,10,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="PASSWORD" />
                <TextBox
                    Margin="0,0,0,5"
                    FontSize="18"
                    Style="{StaticResource InfoInputTextBoxStyle}"
                    Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Margin="0,0,0,5"
                    local:PasswordService.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    FontSize="18"
                    Style="{StaticResource PasswordBoxStyle}"
                    Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=PasswordBox}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="#FF5555"
                                    Text="&#xE783;" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FF5555"
                                    Text="{Binding ErrorContent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox
                    Margin="0,0,0,5"
                    Command="{Binding TogglePasswordVisibilityCommand}"
                    CommandParameter="{Binding ElementName=PasswordBox}"
                    Content="Show Password"
                    Foreground="White" />
                <Button
                    x:Name="RegisterButton"
                    Margin="0,0,0,0"
                    Command="{Binding RegisterCommand}"
                    Content="CREATE ACCOUNT"
                    Style="{StaticResource DefaultButton}"
                    Validation.ErrorTemplate="{x:Null}" />
                <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding (Validation.Errors), ElementName=RegisterButton}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="#FF5555"
                                    Text="&#xE783;" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#FF5555"
                                    Text="{Binding ErrorContent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Already have an account? " />
                    <Button
                        Padding="0"
                        BorderThickness="0"
                        Command="{Binding NavigateToLoginCommand}"
                        Content="Sign Up"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock Style="{StaticResource LinkTextStyle}" Text="Log In" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
