<UserControl
    x:Class="Chess.View.Register"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Chess.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource Brush.Background}"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid Width="420" Height="460">
        <Border
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}">
            <StackPanel Margin="0,-20,0,0">
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    Text="♟" />
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="Create Account" />
                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource SubtitleTextStyle}"
                    Text="Start your chess journey" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="USERNAME" />
                <TextBox
                    Margin="0,0,0,10"
                    FontSize="18"
                    Style="{StaticResource InfoInputTextBoxStyle}" />
                <TextBlock
                    Margin="0,0,0,5"
                    Style="{StaticResource InputLabelStyle}"
                    Text="PASSWORD" />
                <PasswordBox
                    Margin="0,0,0,5"
                    FontSize="18"
                    Style="{StaticResource PasswordBoxStyle}" />
                <CheckBox
                    x:Name="PasswordVisibilityCheckBox"
                    Margin="0,0,0,25"
                    Content="Show Password"
                    Foreground="White" />
                <Button
                    Command="{Binding RegisterCommand}"
                    Content="CREATE ACCOUNT"
                    Style="{StaticResource DefaultButton}" />
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Already have an account? " />
                    <Button
                        Padding="0"
                        BorderThickness="0"
                        Command="{Binding NavigateToLoginCommand}"
                        Content="Sign Up"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock Style="{StaticResource LinkTextStyle}" Text="Log In" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
