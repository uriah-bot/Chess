<Window
    x:Class="Chess.View.AppBase"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Chess.View"
    Title="Chess Master"
    Width="1080"
    Height="720"
    Background="{StaticResource Brush.Background}"
    FontFamily="Segoe UI"
    Icon="/Assets/icon.ico"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="#2A2A2A"
            BorderThickness="0,0,1,0">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Margin="0,20,0,40" Orientation="Horizontal">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource Brush.Accent}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="White"
                                Text="♟" />
                        </Border>
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource Brush.TextPrimary}"
                            Text="CHESS MASTER" />
                    </StackPanel>

                    <RadioButton
                        Uid="Home"
                        Click="Navigate_Click"
                        Content="Home"
                        IsChecked="True"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xE7FC;" />
                    <RadioButton
                        Uid="Classical"
                        Click="Navigate_Click"
                        Content="Classical"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xEA18;" />
                    <RadioButton
                        Uid="Adventure"
                        Click="Navigate_Click"
                        Content="Adventure"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xE819;" />
                    <RadioButton
                        Uid="Statistics"
                        Click="Navigate_Click"
                        Content="Statistics"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xE9D2;" />
                    <RadioButton
                        Uid="Settings"
                        Click="Navigate_Click"
                        Content="Settings"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xE713;" />
                    <RadioButton
                        Uid="Help"
                        Margin="0,50,0,0"
                        Click="Navigate_Click"
                        Content="Help"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="&#xE783;" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="10"
                    Background="{StaticResource Brush.SurfaceElevated}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="35"
                            Height="35"
                            Fill="{StaticResource Brush.Accent}" />

                        <TextBlock
                            Margin="-24,6,0,0"
                            FontFamily="Segoe Emoji"
                            FontSize="20"
                            Foreground="White"
                            Text="𝕏" />

                        <StackPanel Margin="10,0,0,0">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                Text="{Binding Username}" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource Brush.TextSecondary}"
                                Text="{Binding EloText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl
            x:Name="MainContentArea"
            Grid.Column="1"
            Margin="30" />

    </Grid>
</Window>
