<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Chess.View"
    xmlns:vm="clr-namespace:Chess.ViewModel;assembly=Chess.ViewModel">

    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:Login />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
        <views:Register />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GameViewModel}">
        <views:ChessBoard />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppBaseViewModel}">
        <views:AppBase />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:Home />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:Settings />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatsViewModel}">
        <views:Stats />
    </DataTemplate>

</ResourceDictionary>